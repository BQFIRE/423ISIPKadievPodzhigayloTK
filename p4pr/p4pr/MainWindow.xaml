<Window x:Class="p4pr.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Практическая работа 4" Height="720" Width="1100"
WindowStartupLocation="CenterScreen"
Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EAEAEA" BorderBrush="#CFCFCF" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Name="btnPage1"
Content="Первая страница"
Width="150"
Height="35"
Margin="5"
Click="btnPage1_Click"
ToolTip="Перейти на первую страницу"/>

                <Button Name="btnPage2"
Content="Вторая страница"
Width="150"
Height="35"
Margin="5"
Click="btnPage2_Click"
ToolTip="Перейти на вторую страницу"/>

                <Button Name="btnPage3"
Content="Третья страница"
Width="150"
Height="35"
Margin="5"
Click="btnPage3_Click"
ToolTip="Перейти на третью страницу"/>

                <Button Name="btnExit"
Content="Выход"
Width="100"
Height="35"
Margin="5"
Click="btnExit_Click"
ToolTip="Закрыть приложение"/>
            </StackPanel>
        </Border>

        <Frame Name="mainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>