<Page x:Class="p4pr.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page1"
      Background="#F0F0F0">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F0F0F0">
        <Grid Margin="20" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Первая страница"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="Black"
                       Margin="0,0,0,10"/>

            <Border Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="#F0F0F0"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock Text="v = ∛(8 + |x - y|² + 1) / (x² + y² + 2) - e^|x-y| · (tg²z + 1)^x"
                           TextWrapping="Wrap"
                           FontSize="18"
                           Foreground="Black"/>
            </Border>

            <GroupBox Grid.Row="1"
                      Header="Ввод данных"
                      Margin="0,72,0,15"
                      Background="#F0F0F0"
                      Foreground="Black"
                      BorderBrush="Gray" Grid.RowSpan="2">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Label Content="x:"
                               Width="100"
                               Background="#F0F0F0"
                               Foreground="Black"/>
                        <TextBox Name="txtX"
                                 Width="220"
                                 Height="28"
                                 Background="White"
                                 Foreground="Black"
                                 ToolTip="Введите значение x"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Label Content="y:"
                               Width="100"
                               Background="#F0F0F0"
                               Foreground="Black"/>
                        <TextBox Name="txtY"
                                 Width="220"
                                 Height="28"
                                 Background="White"
                                 Foreground="Black"
                                 ToolTip="Введите значение y"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Label Content="z:"
                               Width="100"
                               Background="#F0F0F0"
                               Foreground="Black"/>
                        <TextBox Name="txtZ"
                                 Width="220"
                                 Height="28"
                                 Background="White"
                                 Foreground="Black"
                                 ToolTip="Введите значение z"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3"
                      Header="Результат"
                      Margin="0,0,0,15"
                      Background="#F0F0F0"
                      Foreground="Black"
                      BorderBrush="Gray">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Label Content="Ответ:"
                               Width="100"
                               Background="#F0F0F0"
                               Foreground="Black"/>
                        <TextBox Name="txtResult"
                                 Width="300"
                                 Height="28"
                                 IsReadOnly="True"
                                 Background="White"
                                 Foreground="Black"
                                 ToolTip="Здесь отображается результат"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Name="btnCalc1"
                        Content="Вычислить"
                        Width="130"
                        Height="35"
                        Margin="5"
                        Click="btnCalc1_Click"
                        Background="#E1E1E1"
                        Foreground="Black"
                        BorderBrush="Gray"
                        ToolTip="Вычислить значение функции"/>

                <Button Name="btnClear1"
                        Content="Очистить"
                        Width="130"
                        Height="35"
                        Margin="5"
                        Click="btnClear1_Click"
                        Background="#E1E1E1"
                        Foreground="Black"
                        BorderBrush="Gray"
                        ToolTip="Очистить поля"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>