<Window x:Class="TK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стоимость проезда"
        Height="400" Width="600">

    <Grid Margin="15">
        <StackPanel>

            <TextBlock Text="Расстояние (км)"/>
            <TextBox x:Name="DistanceTextBox"/>

            <TextBlock Text="Количество билетов"/>
            <TextBox x:Name="TicketsTextBox"/>

            <TextBlock Text="Тип вагона"/>
            <StackPanel>
                <RadioButton x:Name="Platzkart" Content="Плацкарт" IsChecked="True"/>
                <RadioButton x:Name="Kupe" Content="Купе"/>
                <RadioButton x:Name="Polylux" Content="Полулюкс"/>
                <RadioButton x:Name="Lux" Content="Люкс"/>
            </StackPanel>

            <Button Content="Вычислить" Click="Calculate_Click"/>
            <TextBox x:Name="ResultBox" IsReadOnly="True"/>

        </StackPanel>
    </Grid>
</Window>